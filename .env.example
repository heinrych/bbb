# Copie para `.env` e preencha.
#
# Segurança QA:
# - Se `QA_LOCAL_ONLY=1`, o runner recusa `SITE_URL` que não resolva para IP privado/loopback.

# Obrigatórios
SITE_URL=http://host.docker.internal:8080/
LOGIN_URL=
CANDIDATO=

# Usuários (separados por vírgula)
USER_EMAIL=user1@example.com,user2@example.com
USER_PASSWORD=coloque_sua_senha_aqui

# Execução/Chrome (opcional)
QA_LOCAL_ONLY=1
CHROME_HEADLESS=1
BRING_TO_FRONT=0

# DevTools (cada instância precisa de uma porta diferente)
DEBUG_PORT=9222

# Perfil (em Docker normalmente fica assim)
MAIN_USER_DATA_DIR=/tmp/chrome-debug
PROFILE_DIR=Default

# Contador (opcional)
COUNTER_FILE=artifacts/count.txt
KILL_CHROME_ON_RETRY=1

